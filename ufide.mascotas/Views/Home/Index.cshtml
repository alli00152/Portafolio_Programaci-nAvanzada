@model ufide.mascotas.Models.ViewModels.MascotaListaViewModel

@{
    ViewBag.Title = "Mascotas registradas";
}

<main>
    <div class="row mt-3">
        <div class="col-md-8">
            <h2>Mascotas registradas</h2>
            <p class="text-muted mb-0">@ViewBag.Subtitulo</p>
            <small>Consulta: @ViewData["FechaConsulta"]</small>
        </div>
        <div class="col-md-4 text-end">
            @Html.ActionLink("Registrar mascota", "Registrar", "Home", null, new { @class = "btn btn-primary" })
        </div>
    </div>

    @* Filtro por período de nacimiento: usa el Model Binder personalizado *@
    @using (Html.BeginForm("Buscar", "Home", FormMethod.Get, new { @class = "row g-2 my-3" }))
    {
        <div class="col-auto">
            <input type="number" name="mes" class="form-control" placeholder="Mes (1-12)" min="1" max="12" />
        </div>
        <div class="col-auto">
            <input type="number" name="anio" class="form-control" placeholder="Año" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-secondary">Buscar por período</button>
            @Html.ActionLink("Ver todas", "Index", "Home", null, new { @class = "btn btn-link" })
        </div>
    }

    @if (Model.Mascotas.Any())
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nombre</th>
                    <th>Especie</th>
                    <th>Tipo</th>
                    <th>Nacimiento</th>
                    <th>&nbsp;</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Mascotas.Count; i++)
                {
                    var mascota = Model.Mascotas[i];

                    <tr>
                        <td>@(i + 1)</td>
                        <td>@mascota.Nombre</td>
                        <td>@mascota.TipoEspecie.ToString()</td>
                        <td>@mascota.Tipo</td>
                        <td>@mascota.FechaNacimiento.ToString("MMMM yyyy")</td>
                        <td>
                            @Html.ActionLink("Ver detalle", "Detalle", "Home", new { id = mascota.Id }, new { @class = "btn btn-outline-primary btn-sm" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">No hay mascotas registradas.</div>
    }

    <p>
        @Html.ActionLink("Estado del servicio", "Estado", "Home", null, new { @class = "btn btn-info" })
        @Html.ActionLink("Descargar lista CSV", "DescargarLista", "Home", null, new { @class = "btn btn-success" })
        @Html.ActionLink("Ir al inicio", "IrAInicio", "Home", null, new { @class = "btn btn-secondary" })
    </p>
</main>
